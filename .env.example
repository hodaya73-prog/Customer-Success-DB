# Copy this file to ".env" (exactly that name, no .txt) and fill in the values.
# The real .env is ignored by git and must never be committed.
#
# IMPORTANT: do NOT rename these with a VITE_ prefix. Variables that start with VITE_
# are copied into the public JavaScript file, where anyone can read them.

# Airtable personal access token (airtable.com/create/tokens): data.records:read + data.records:write, one base only
AIRTABLE_TOKEN=
# Base ID: starts with "app", visible in the base URL
AIRTABLE_BASE_ID=
# Optional. Table name, defaults to Customers
AIRTABLE_TABLE=Customers
